# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
# Replace <username>, <password> and add /financetracker before the ?
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/financetracker?retryWrites=true&w=majority

# Any long random string (used to sign login tokens)
JWT_SECRET=change_this_to_a_long_random_string

# Port Render will inject its own PORT, this is just a local fallback
PORT=5000

# Your deployed Vercel frontend URL (used for CORS). Add after you deploy the frontend.
CLIENT_URL=http://localhost:5500
